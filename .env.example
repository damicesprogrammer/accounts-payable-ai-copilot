# Copie para .env e ajuste se necessário. Todos os valores têm default no docker-compose.yml.
POSTGRES_USER=ap_copilot
POSTGRES_PASSWORD=ap_copilot
POSTGRES_DB=ap_copilot
POSTGRES_PORT=5432
API_PORT=8000
LOG_LEVEL=INFO

# IA (opcional). A API financeira funciona sem estas variáveis.
# Nunca versione o arquivo .env com a chave real.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
